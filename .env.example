# Copy to .env and fill in. .env stays out of git.
# docker compose reads it, so does the server when run locally (uvicorn), and the Android build (ANDROID_*).

# ---------- server ----------

# Host port the site is published on.
PORT=8000

# true when the site is served over HTTPS (tailscale serve, a reverse proxy...). Leave false if you
# also use a plain http:// address, or logging in there stops working.
COOKIE_SECURE=false

# Ollama server with a vision model, for reading recipes and shopping lists from photos.
# Empty turns that off (recipe links still import from their structured data).
OLLAMA_URL=
# e.g. OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=gemma4:26b-a4b-it-qat
# Seconds to wait for an answer.
OLLAMA_TIMEOUT=300
# Model context size in tokens; Ollama's default of 4096 is too small for four photos plus directions.
OLLAMA_NUM_CTX=8192

# The household's time zone, for "today" and "this week" on the meal calendar (the server may run on UTC).
TIMEZONE=UTC

# ---------- Android app (read when building it) ----------

# The app's id. Keep the same id (and signing key) for updates to install over an installed app.
ANDROID_APP_ID=com.example.pantri
# Your server's address, filled in on the login screen. Empty: the field starts blank.
ANDROID_SERVER_URL=
